generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id                    Int      @id @default(autoincrement())
  name                  String
  email                 String   @unique
  password              String   // Stores password hash
  role                  Role     @default(USER)
  gender                Gender   @default(Other)
  height                Float?
  weight                Float?
  shoulder              Float?
  chest                 Float?
  waist                 Float?
  hips                  Float?
  total_orders          Int      @default(0)
  last_category         String?
  last_product_type     String?
  days_since_last_order Int?
  referral_code         String   @unique
  total_commission      Float    @default(0.0)

  // Custom fields we retain to prevent model wardrobe profiles and request 3 from breaking
  isModel               Boolean  @default(false)
  photo                 String?
  bodyDescription       String?  @db.Text
  clothesTaste          String?  @db.Text
  wallet_balance        Float    @default(0.0) // Kept for balance flow
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt

  avatar                Avatar?
  orders                Order[]
  wardrobe_items        Wardrobe[]
  commissions           Commission[]  @relation("ReferrerCommissions")

  @@map("users")
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  M
  F
  Other
}

// ─── Avatars ─────────────────────────────────────────────────────────────────

model Avatar {
  id               Int          @id @default(autoincrement())
  user_id          Int          @unique
  metahuman_id     String       // "BP_Avatar_01" ... "BP_Avatar_05"
  status           AvatarStatus @default(PENDING)
  photos_urls      Json?        // 6 S3 URLs stored as JSON array
  body_height      Float?
  body_weight      Float?
  body_chest       Float?
  body_waist       Float?
  body_hips        Float?
  estimated_ready  DateTime?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt

  user             User         @relation(fields: [user_id], references: [id])

  @@map("avatars")
}

enum AvatarStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

// ─── Markets ─────────────────────────────────────────────────────────────────

model Market {
  id          String    @id @default(uuid())
  name        String    // "Zara", "Gucci", etc.
  logo_url    String
  banner_url  String
  description String
  created_at  DateTime  @default(now())

  products    Product[]

  @@map("markets")
}

// ─── Products ─────────────────────────────────────────────────────────────────

model Product {
  id             Int      @id @default(autoincrement())
  name           String
  brand          String
  category       String
  product_type   String
  description    String   @db.Text
  price          Float
  image_url      String
  model_3d_url   String?  // Holds the UE skeletal mesh asset key (e.g. "outfit_zara_white_tee")
  size_chest_min Float?
  size_chest_max Float?
  size_waist_min Float?
  size_waist_max Float?
  size_hip_min   Float?
  size_hip_max   Float?
  stock          Int      @default(10)

  // Keep optional relation to Market for brand catalogs
  market_id      String?
  market         Market?   @relation(fields: [market_id], references: [id])

  wardrobe_items Wardrobe[]
  order_items    OrderItem[]

  @@map("products")
}

// ─── Wardrobe ─────────────────────────────────────────────────────────────────

model Wardrobe {
  id         Int      @id @default(autoincrement())
  user_id    Int
  product_id Int
  added_at   DateTime @default(now())

  user       User     @relation(fields: [user_id], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])

  @@unique([user_id, product_id])
  @@map("wardrobe")
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id           Int         @id @default(autoincrement())
  user_id      Int
  total_amount Float
  status       OrderStatus @default(pending)
  referred_by  Int?        // Referrer user ID
  created_at   DateTime    @default(now())

  user         User        @relation(fields: [user_id], references: [id])
  items        OrderItem[]
  commissions  Commission[]

  @@map("orders")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  order_id   Int
  product_id Int
  quantity   Int      @default(1)
  unit_price Float
  size       String   @default("M")

  order      Order    @relation(fields: [order_id], references: [id])
  product    Product  @relation(fields: [product_id], references: [id])

  @@map("order_items")
}

enum OrderStatus {
  pending
  paid
  shipped
  delivered
  returned
}

// ─── Commissions ─────────────────────────────────────────────────────────────

model Commission {
  id          Int              @id @default(autoincrement())
  referrer_id Int
  order_id    Int
  amount      Float
  status      CommissionStatus @default(pending)
  created_at  DateTime         @default(now())

  referrer    User             @relation("ReferrerCommissions", fields: [referrer_id], references: [id])
  order       Order            @relation(fields: [order_id], references: [id])

  @@map("commissions")
}

enum CommissionStatus {
  pending
  paid
}
